---
import { faqGroups, inlineMarkdown } from "../../lib/biscettaFaq";
---

<article class="faq-page">
  <header class="page-intro">
    <h1>FAQ</h1>
    <p class="updated-at">最終更新日：2026年9月10日</p>
  </header>
  <div class="faq-groups">
    {faqGroups.map((group) => (
      <section class="faq-group" aria-labelledby={`faq-${group.title}`}>
        {group.items.map((item) => (
          <article class="faq-item">
            <h3>
              <span aria-hidden="true">Q.</span> {item.question}
            </h3>
            <div class="faq-answer">
              <span class="faq-answer__mark" aria-hidden="true">
                A.
              </span>
              <div>
                {item.blocks.map((block) =>
                  block.type === "paragraph" ? (
                    <p set:html={inlineMarkdown(block.text)} />
                  ) : (
                    <ul>
                      {block.items.map((listItem) => (
                        <li set:html={inlineMarkdown(listItem)} />
                      ))}
                    </ul>
                  ),
                )}
              </div>
            </div>
          </article>
        ))}
      </section>
    ))}
  </div>
  <aside class="support-block" aria-labelledby="support-title">
    <h2 id="support-title">解決しない場合</h2>
    <p>
      アプリ内の問い合わせ機能、または <a href="mailto:biscetta@berryrook.com">biscetta@berryrook.com</a> からお問い合わせください。
    </p>
  </aside>
</article>
