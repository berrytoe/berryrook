---
import Layout from "../layouts/Layout.astro";

const title = "About｜BERRYROOK";
---

<Layout title={title}>
  <section class="about">
    <hgroup>
      <h1>About</h1>
      <p>アプリケーションの企画・開発をしています。</p>
    </hgroup>
    <table>
      <tbody>
        <tr>
          <th scope="row">屋号</th>
          <td>BERRYROOK</td>
        </tr>
        <tr>
          <th scope="row">所在地</th>
          <td>大阪府大阪市中央区東心斎橋1丁目9-19 ミトオリアートビル 307号室</td>
        </tr>
        <tr>
          <th scope="row">主要連絡先</th>
          <td>
            <a href="mailto:hello@berryrook.com">hello@berryrook.com</a>
          </td>
        </tr>
        <tr>
          <th scope="row">公式サイト</th>
          <td>
            <a href="https://berryrook.com/">https://berryrook.com</a>
          </td>
        </tr>
      </tbody>
    </table>
    <p style="font-size: 0.875em;">お問い合わせの際の情報（お名前、メールアドレス、お問合せ内容）は、返信およびご本人確認の目的にのみ使用し、適切に管理いたします。</p>
  </section>
  <section>
    <h2>Developer</h2>
    <p>
      berrytoe <a href="https://x.com/veryberrytoe">@veryberrytoe</a>
    </p>
  </section>
</Layout>

<style>
  .about table {
    inline-size: 100%;
    border-collapse: collapse;
    background: var(--biscetta-surface);
    font-size: 15px;
  }

  .about th,
  .about td {
    border: 1px solid #fff;
    padding: 12px;
    text-align: start;
    vertical-align: top;
  }

  .about th {
    width: 6em;
  }
</style>
