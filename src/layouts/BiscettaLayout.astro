---
import Header from "../components/biscetta/Header.astro";
import Footer from "../components/biscetta/Footer.astro";
import "../styles/biscetta.css";

type Props = {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  structuredData?: Record<string, unknown>;
};

const { title, description, path, image = "/biscetta/ogp.png", imageAlt = "Biscetta公式ページ。レシピ一覧のアプリ画面と、お気に入りのレシピをひとつの場所にまとめられることを紹介しています。", robots = "index, follow, max-image-preview:large", structuredData } = Astro.props;
const siteOrigin = Astro.site ?? new URL("https://berryrook.com/");
const canonical = new URL(path, siteOrigin);
const ogImage = new URL(image, siteOrigin);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f0ee" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/biscetta/favicon.svg" />
    <link rel="icon" href="/biscetta/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="BERRYROOK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
  </head>
  <body>
    <div id="wrapper">
      <a class="skip-link" href="#main-content">
        本文へ移動
      </a>
      <Header currentPath={Astro.url.pathname} />
      <main id="main-content">
        <slot />
      </main>
      <Footer currentPath={Astro.url.pathname} />
    </div>
  </body>
</html>
